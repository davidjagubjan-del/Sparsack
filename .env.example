# Kopieren nach .env und befuellen. Diese Datei kommt NIE ins Repo mit echten Werten.
DATABASE_URL=postgres://user:pass@localhost:5432/coincurb
JWT_SECRET=            # mind. 32 zufaellige Zeichen, z.B.: openssl rand -base64 48
HASH_PEPPER=           # mind. 32 zufaellige Zeichen, NIE mehr aendern nach Start
APP_URL=https://deine-domain.de
PORT=3000
# Weitere erlaubte Browser-Origins, kommagetrennt (z.B. Capacitor: capacitor://localhost,http://localhost)
CORS_ORIGINS=
# Oeffentliche Basis-URL der Postbacks, genau wie im Partner-Dashboard eingetragen (BitLabs hasht die volle URL)
POSTBACK_BASIS=https://api.deine-domain.de
# Alle Partner melden in US-Dollar; Kurs fuer die Umrechnung in Euro (regelmaessig anpassen)
USD_EUR=0.90

# Partner-Postback-Secrets (aus dem jeweiligen Dashboard) — Postback-URLs je Partner stehen in README.md
ADGATE_SECRET=          # frei gewaehlter langer Zufallswert, wird als token in die Postback-URL eingebaut (AdGate hat keinen Hash)
AYET_SECRET=            # Publisher-API-Key (Account Settings)
TOROX_SECRET=           # Secret Key der App
LOOTABLY_SECRET=        # Postback Secret des Placements
BITLABS_SECRET=         # App Secret
CPX_SECRET=             # Secure Hash der App
# Oeffentliche IDs fuer die Angebotswaende (duerfen in Links stehen); leer = Partner erscheint nicht in der App
ADGATE_WALL_ID=
AYET_PLACEMENT=
TOROX_OFFERWALL_ID=
LOOTABLY_PLACEMENT=
BITLABS_TOKEN=
CPX_APP_ID=
# Postback-IP-Allowlists je Partner: IPv4/IPv6, Einzeladressen oder CIDR, kommagetrennt.
# Leer = jede IP erlaubt. Ohne Angabe gelten die dokumentierten Listen von AdGate und BitLabs.
# Torox und CPX signieren den Betrag NICHT mit — dort die IPs aus dem Dashboard unbedingt eintragen.
ADGATE_IPS=
AYET_IPS=
TOROX_IPS=
LOOTABLY_IPS=
BITLABS_IPS=
CPX_IPS=

# Auszahlungen — freigeschaltete Wege, kommagetrennt: paypal,amazon,steam,bank,crypto
AUSZAHLUNG_AKTIV=
# Auszahlungsziele liegen verschluesselt in der DB; mind. 32 Zeichen, NIE aendern, sonst sind alte Ziele unlesbar
ZIEL_SCHLUESSEL=
ZAHLUNG_TIMEOUT_MS=15000
# PayPal Payouts: Business-Konto mit freigeschalteter Payouts-API; sandbox | live
PAYPAL_UMGEBUNG=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Tango Card RaaS: Platform-Name + Key, Account/Customer aus dem Portal, UTIDs je Gutschein (z.B. Amazon.de, Steam EUR)
TANGO_UMGEBUNG=sandbox
TANGO_PLATFORM=
TANGO_KEY=
TANGO_ACCOUNT=
TANGO_CUSTOMER=
TANGO_UTID_AMAZON=
TANGO_UTID_STEAM=
WISE_TOKEN=
COINBASE_KEY=

# Sign in with Apple: Bundle-ID der iOS-App, bei Web-Login zusaetzlich die Services-ID (kommagetrennt)
APPLE_BUNDLE_ID=

# Proxy-/VPN-Erkennung (Aufgabe 7): IPQualityScore-Key; leer = keine Pruefung, Netztyp bleibt "unbekannt"
IPQS_KEY=
IPQS_TIMEOUT_MS=3000

# Tests: eigene Datenbank, wird bei jedem `npm test` geleert und neu aufgebaut
TEST_DATABASE_URL=postgres://user:pass@localhost:5432/coincurb_test

# Versand: Mail ueber Resend (Domain dort verifizieren), SMS-Codes ueber Twilio Verify (Verify-Service anlegen)
RESEND_KEY=
MAIL_ABSENDER=CoinCurb <no-reply@deine-domain.de>
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_VERIFY_SID=
VERSAND_TIMEOUT_MS=10000
